.loading,
.error {
  padding: 15px;
  margin-bottom: 20px;
  border-radius: 4px;
  text-align: center;
}
/*
  guide to gallery css: https://www.w3schools.com/howto/howto_css_image_grid_responsive.asp
*/
.galleryRow{
  display: flex;
  flex-wrap: wrap;
  padding: 2.5% 0;
  z-index: 1;
  justify-content: center;
}

.galleryColumn{
  flex: 30%;
  max-width: 30%;
  padding: 1% 1%;
  z-index: inherit;
}

.galleryColumn img{
  width: 100%;
  height: 100%;
  vertical-align: middle;
  object-fit: contain;
}

@media(max-width: 800px){
  .galleryColumn{
    flex: 40%;
    max-width: 40%;
    padding: 5% 5%;
  }
}

@media(max-width: 600px){
  .galleryColumn{
    flex: 100%;
    max-width: 100%;
    padding: 5% 5%;
  }
}

.galleryButton{
  visibility: force-hidden;
}



.loading {
  background-color: #e3f2fd;
  color: #1976d2;
}

.error {
  background-color: #ffebee;
  color: #c62828;
}

.no-results {
  text-align: center;
  color: #999;
  padding: 40px;
}
