<!DOCTYPE html>

@if(isLoading())
{
  <div class="loading">
    Loading photos...
  </div>
}

<!-- Error State -->
@if(errorMessage())
{
  <div class="error">
    {{ errorMessage() }}
  </div>
}

@if(!isLoading() && !errorMessage()){
  <div class="galleryRow">
    @for (photo of photos(); track photo.id)
    {
      <div class="galleryColumn">
        <img alt="" src="{{photo.imageUrl}}">
      </div>
    }
  </div>
}
