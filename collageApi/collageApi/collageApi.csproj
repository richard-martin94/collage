<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.107" />
        <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.102.1" />
        <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
        <PackageReference Include="AWSSDK.SQS" Version="4.0.100.15" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
        <PackageReference Include="System.Text.Json" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

</Project>
