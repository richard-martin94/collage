    <Import Project="$(NuGetPackageRoot)microsoft.testing.extensions.telemetry/2.5.1/buildTransitive/net9.0/Microsoft.Testing.Extensions.Telemetry.props" Condition="Exists('$(NuGetPackageRoot)microsoft.testing.extensions.telemetry/2.5.1/buildTransitive/net9.0/Microsoft.Testing.Extensions.Telemetry.props')" />
    <Import Project="$(NuGetPackageRoot)xunit.v3.core.mtp-v2/4.0.2/buildTransitive/xunit.v3.core.mtp-v2.props" Condition="Exists('$(NuGetPackageRoot)xunit.v3.core.mtp-v2/4.0.2/buildTransitive/xunit.v3.core.mtp-v2.props')" />
    <Import Project="$(NuGetPackageRoot)xunit.runner.visualstudio/4.0.1/build/net8.0/xunit.runner.visualstudio.props" Condition="Exists('$(NuGetPackageRoot)xunit.runner.visualstudio/4.0.1/build/net8.0/xunit.runner.visualstudio.props')" />
  </ImportGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <Pkgxunit_analyzers Condition=" '$(Pkgxunit_analyzers)' == '' ">/home/richard/.nuget/packages/xunit.analyzers/2.2.0</Pkgxunit_analyzers>
    <PkgNSubstitute_Analyzers_CSharp Condition=" '$(PkgNSubstitute_Analyzers_CSharp)' == '' ">/home/richard/.nuget/packages/nsubstitute.analyzers.csharp/1.0.17</PkgNSubstitute_Analyzers_CSharp>
    <PkgAWSSDK_Core Condition=" '$(PkgAWSSDK_Core)' == '' ">/home/richard/.nuget/packages/awssdk.core/4.0.102.11</PkgAWSSDK_Core>
    <PkgAWSSDK_SQS Condition=" '$(PkgAWSSDK_SQS)' == '' ">/home/richard/.nuget/packages/awssdk.sqs/4.0.100.18</PkgAWSSDK_SQS>
    <PkgAWSSDK_S3 Condition=" '$(PkgAWSSDK_S3)' == '' ">/home/richard/.nuget/packages/awssdk.s3/4.0.104.4</PkgAWSSDK_S3>
    <PkgAWSSDK_DynamoDBv2 Condition=" '$(PkgAWSSDK_DynamoDBv2)' == '' ">/home/richard/.nuget/packages/awssdk.dynamodbv2/4.0.107.3</PkgAWSSDK_DynamoDBv2>
